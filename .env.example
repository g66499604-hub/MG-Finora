# Supabase Cloud Database & Authentication (Optional)
# If provided, the application synchronizes with your Supabase PostgreSQL backend.
# If not provided, MG-Finora seamlessly runs in encrypted Local Vault mode on GitHub Pages.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Gemini AI API Key (Optional)
# Configured via AI Studio Secrets Panel if AI analysis features are activated
# GEMINI_API_KEY=
